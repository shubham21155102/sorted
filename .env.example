# Copy to .env and fill in. The CLI and the demo server load .env automatically
# (real environment variables take precedence). Never commit .env.

# Model adapter: litellm | scripted | replay:<cassette.jsonl>
# Default: litellm if ERRAND_MODEL is set, otherwise the offline scripted model.
ERRAND_LLM=litellm

# Default model: a LiteLLM model id (provider/model) or a model name on your LiteLLM proxy.
# Users can switch models per chat in the app; the picker lists the proxy's tool-capable chat models.
ERRAND_MODEL=

# Optional: limit the model picker to these models (comma-separated, shown in this order).
ERRAND_MODELS=

# LiteLLM proxy / endpoint and its key.
LITELLM_API_BASE=
LITELLM_API_KEY=

# Optional: record every model response to this JSONL cassette (replay later with ERRAND_LLM=replay:<path>).
ERRAND_RECORD=

# --- Voice and phone calls. Credentials live in gitignored files under secrets/:
#   secrets/livekit.env    LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
#   secrets/sarvam.env     SARVAM_API_KEY  (when present, calls use Sarvam speech)
#   secrets/telephony.env  written by `python -m errand_agent.telephony setup`
# Speech provider: sarvam | livekit (default: sarvam if SARVAM_API_KEY is set)
ERRAND_VOICE_PROVIDER=
# Sarvam language and voice (e.g. en-IN, hi-IN; speakers: kavya, rahul, priya, aditya, ...)
ERRAND_VOICE_LANGUAGE=en-IN
ERRAND_SARVAM_SPEAKER=kavya
# LiveKit Inference models (used when the provider is livekit):
ERRAND_STT=deepgram/nova-3
ERRAND_TTS=cartesia/sonic-3
ERRAND_TTS_VOICE=
# Pause (seconds) before the caller's turn is considered finished.
ERRAND_ENDPOINT_DELAY=1.0

# --- Phone calls via Sarvam Voice Agents (see README → Phone calls via Sarvam)
SARVAM_AGENT_NUMBER=
ERRAND_SARVAM_TOKEN=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_VA_API_KEY=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
ERRAND_PUBLIC_URL=
