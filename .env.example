# Copy to .env and fill in. The CLI and the demo server load .env automatically
# (real environment variables take precedence). Never commit .env.

# Anthropic API key — required for live mode. Without it the app runs the offline scripted model.
ANTHROPIC_API_KEY=

# Which model adapter to use: litellm | live (Anthropic SDK) | scripted | replay:<cassette.jsonl>
# Default: live if ANTHROPIC_API_KEY is set, otherwise scripted.
ERRAND_LLM=litellm

# Model id. With litellm use provider/model, e.g. anthropic/claude-opus-5, openai/gpt-4.1,
# gemini/gemini-2.5-pro — or a model alias defined on your LiteLLM proxy.
# With ERRAND_LLM=live use a bare Claude id, e.g. claude-opus-5.
ERRAND_MODEL=anthropic/claude-opus-5

# LiteLLM provider keys: set the one(s) for the provider in ERRAND_MODEL
# (ANTHROPIC_API_KEY above, or OPENAI_API_KEY, GEMINI_API_KEY, ...).
OPENAI_API_KEY=

# Optional: route through a LiteLLM proxy instead of calling providers directly.
LITELLM_API_BASE=
LITELLM_API_KEY=

# Server-side refusal fallbacks, Anthropic SDK adapter only (1 = on, 0 = off).
ERRAND_FALLBACKS=1

# Optional: record every live model response to this JSONL cassette (replay later with ERRAND_LLM=replay:<path>).
ERRAND_RECORD=
