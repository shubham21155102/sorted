# Copy to .env and fill in. The CLI and the demo server load .env automatically
# (real environment variables take precedence). Never commit .env.

# Model adapter: litellm | scripted | replay:<cassette.jsonl>
# Default: litellm if ERRAND_MODEL is set, otherwise the offline scripted model.
ERRAND_LLM=litellm

# LiteLLM model id (provider/model, e.g. openai/gpt-4.1, gemini/gemini-2.5-pro),
# or the model alias defined on your LiteLLM proxy.
ERRAND_MODEL=

# LiteLLM proxy / endpoint and its key.
LITELLM_API_BASE=
LITELLM_API_KEY=

# Optional: record every model response to this JSONL cassette (replay later with ERRAND_LLM=replay:<path>).
ERRAND_RECORD=
