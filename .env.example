# Copy to .env and fill in. The CLI and the demo server load .env automatically
# (real environment variables take precedence). Never commit .env.

# Anthropic API key — required for live mode. Without it the app runs the offline scripted model.
ANTHROPIC_API_KEY=

# Which model adapter to use: live | scripted | replay:<cassette.jsonl>
# Default: live if ANTHROPIC_API_KEY is set, otherwise scripted.
ERRAND_LLM=

# Claude model for live mode.
ERRAND_MODEL=claude-opus-5

# Server-side refusal fallbacks (1 = on, 0 = off).
ERRAND_FALLBACKS=1

# Optional: record every live model response to this JSONL cassette (replay later with ERRAND_LLM=replay:<path>).
ERRAND_RECORD=
